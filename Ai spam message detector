<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Spam Shield - Intelligent Message Detector</title>
    <!-- Tailwind CSS via CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- Inter Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 h-full flex flex-col selection:bg-indigo-500 selection:text-white">

    <!-- GLOBAL NOTIFICATION TOAST -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- ========================================================== -->
    <!-- VIEW 1: AUTHENTICATION SCREEN (Default when logged out)     -->
    <!-- ========================================================== -->
    <div id="auth-view" class="flex-1 flex items-center justify-center p-4 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-900 via-slate-950 to-black">
        <div class="w-full max-w-md bg-slate-900/80 backdrop-blur-xl border border-slate-800 rounded-2xl shadow-2xl overflow-hidden p-8">
            
            <!-- Logo Header -->
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-indigo-600/20 border border-indigo-500/30 text-indigo-400 mb-3 shadow-inner">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                    </svg>
                </div>
                <h1 class="text-2xl font-bold tracking-tight text-white">AI Spam Shield</h1>
                <p class="text-sm text-slate-400 mt-1">Protect your inbox with enterprise-grade machine learning</p>
            </div>

            <!-- Tab Switcher -->
            <div class="flex rounded-xl bg-slate-950 p-1 border border-slate-800 mb-6">
                <button onclick="switchAuthTab('signin')" id="tab-signin" class="flex-1 py-2 text-sm font-medium rounded-lg transition-all bg-indigo-600 text-white shadow-sm">Sign In</button>
                <button onclick="switchAuthTab('signup')" id="tab-signup" class="flex-1 py-2 text-sm font-medium rounded-lg transition-all text-slate-400 hover:text-white">Sign Up</button>
            </div>

            <!-- SIGN IN FORM -->
            <form id="form-signin" onsubmit="handleSignIn(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Email Address</label>
                    <input type="email" id="signin-email" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all placeholder:text-slate-600" placeholder="name@example.com">
                </div>
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400">Password</label>
                        <button type="button" onclick="openForgotPasswordModal()" class="text-xs text-indigo-400 hover:text-indigo-300 font-medium">Forgot password?</button>
                    </div>
                    <input type="password" id="signin-password" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all placeholder:text-slate-600" placeholder="••••••••">
                </div>
                <button type="submit" id="btn-signin-submit" class="w-full mt-2 bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white font-medium py-3 rounded-xl transition-all shadow-lg shadow-indigo-600/20 flex items-center justify-center gap-2">
                    <span>Sign In to Dashboard</span>
                </button>
            </form>

            <!-- SIGN UP FORM -->
            <form id="form-signup" onsubmit="handleSignUp(event)" class="space-y-4 hidden">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Full Name</label>
                    <input type="text" id="signup-name" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all placeholder:text-slate-600" placeholder="John Doe">
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Email Address</label>
                    <input type="email" id="signup-email" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all placeholder:text-slate-600" placeholder="name@example.com">
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Password</label>
                    <input type="password" id="signup-password" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all placeholder:text-slate-600" placeholder="••••••••">
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Confirm Password</label>
                    <input type="password" id="signup-confirm" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all placeholder:text-slate-600" placeholder="••••••••">
                </div>
                <button type="submit" id="btn-signup-submit" class="w-full mt-2 bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white font-medium py-3 rounded-xl transition-all shadow-lg shadow-indigo-600/20 flex items-center justify-center gap-2">
                    <span>Create Account</span>
                </button>
            </form>

            <div class="mt-6 text-center border-t border-slate-800/80 pt-4">
                <p class="text-xs text-slate-500">Demo mode is active by default. Works seamlessly offline or with FastAPI server on port 8000.</p>
            </div>
        </div>
    </div>

    <!-- FORGOT PASSWORD MODAL -->
    <div id="forgot-password-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm hidden p-4">
        <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-2xl space-y-4">
            <div class="flex items-center justify-between pb-2 border-b border-slate-800">
                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                    <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 0121 9z"></path>
                    </svg>
                    Reset Password
                </h3>
                <button onclick="closeForgotPasswordModal()" class="text-slate-400 hover:text-white transition-all">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            <p class="text-xs text-slate-400">Enter your account email address. We will send you a secure link to reset your password.</p>
            <form onsubmit="handleSendResetLink(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Email Address</label>
                    <input type="email" id="reset-email-input" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 placeholder:text-slate-600" placeholder="name@example.com">
                </div>
                <div class="flex justify-end gap-3 pt-2">
                    <button type="button" onclick="closeForgotPasswordModal()" class="px-4 py-2 text-xs font-medium text-slate-400 hover:text-slate-200">Cancel</button>
                    <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-medium px-5 py-2 rounded-xl transition-all shadow-md shadow-indigo-600/20">Send Reset Link</button>
                </div>
            </form>
        </div>
    </div>

    <!-- CONNECT MAIL ACCOUNT MODAL -->
    <div id="connect-mail-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm hidden p-4">
        <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-2xl space-y-4">
            <div class="flex items-center justify-between pb-2 border-b border-slate-800">
                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                    <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                    Connect Email Account
                </h3>
                <button onclick="closeConnectMailModal()" class="text-slate-400 hover:text-white transition-all">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            <p class="text-xs text-slate-400">Connect your mailbox (Gmail/IMAP) or import custom emails directly into the detector workspace.</p>
            
            <form onsubmit="handleConnectAccount(event)" class="space-y-3">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Email Service Provider</label>
                    <select id="mail-provider" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-indigo-500">
                        <option value="gmail">Gmail / Google Workspace (OAuth / App Pass)</option>
                        <option value="outlook">Outlook / Office 365</option>
                        <option value="imap">Custom IMAP / Webmail</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Your Email Address</label>
                    <input type="email" id="connect-email-input" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-xs text-slate-200 focus:outline-none focus:border-indigo-500 placeholder:text-slate-600" placeholder="my.inbox@example.com">
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">App Password / Auth Token</label>
                    <input type="password" id="connect-token-input" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-xs text-slate-200 focus:outline-none focus:border-indigo-500 placeholder:text-slate-600" placeholder="••••••••••••••••">
                </div>

                <div class="pt-2 border-t border-slate-800/80">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-indigo-400 mb-1">Or Quick Import Raw Email Text</label>
                    <textarea id="import-raw-mail" rows="3" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2 text-xs font-mono text-slate-200 focus:outline-none focus:border-indigo-500 placeholder:text-slate-600 resize-none" placeholder="Paste full email header + body here to add to inbox list..."></textarea>
                </div>

                <div class="flex justify-end gap-3 pt-2">
                    <button type="button" onclick="closeConnectMailModal()" class="px-4 py-2 text-xs font-medium text-slate-400 hover:text-slate-200">Cancel</button>
                    <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-medium px-5 py-2 rounded-xl transition-all shadow-md shadow-indigo-600/20">Sync Mailbox</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MAIL PREVIEW DRAWER / MODAL -->
    <div id="mail-drawer" class="fixed inset-0 z-50 flex justify-end bg-slate-950/70 backdrop-blur-sm hidden">
        <div class="w-full max-w-lg bg-slate-900 border-l border-slate-800 h-full p-6 flex flex-col justify-between shadow-2xl overflow-y-auto">
            <div>
                <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
                    <h3 class="text-sm font-bold text-white uppercase tracking-wider">Email Inspector</h3>
                    <button onclick="closeMailDrawer()" class="text-slate-400 hover:text-white transition-all">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
                <div class="space-y-3 text-xs">
                    <div>
                        <span class="text-slate-500 block">From:</span>
                        <span id="drawer-sender" class="font-semibold text-slate-200">--</span>
                    </div>
                    <div>
                        <span class="text-slate-500 block">Subject:</span>
                        <span id="drawer-subject" class="font-semibold text-slate-200">--</span>
                    </div>
                    <div class="pt-3 border-t border-slate-800">
                        <span class="text-slate-500 block mb-1">Body Content:</span>
                        <div id="drawer-body" class="bg-slate-950 border border-slate-800 rounded-xl p-3 font-mono text-slate-300 leading-relaxed whitespace-pre-wrap">--</div>
                    </div>
                </div>
            </div>
            <div class="pt-4 border-t border-slate-800 flex justify-end gap-3">
                <button onclick="closeMailDrawer()" class="px-4 py-2 text-xs text-slate-400 hover:text-slate-200">Close</button>
            </div>
        </div>
    </div>

    <!-- ========================================================== -->
    <!-- VIEW 2: AI SPAM DETECTOR DASHBOARD (Visible when logged in) -->
    <!-- ========================================================== -->
    <div id="dashboard-view" class="hidden flex-1 flex flex-col min-h-full">
        
        <!-- Top Bar Header -->
        <header class="border-b border-slate-800 bg-slate-900/50 backdrop-blur-md sticky top-0 z-40">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                        </svg>
                    </div>
                    <div>
                        <h1 class="font-bold text-base text-white tracking-tight">AI Spam Shield</h1>
                        <div class="flex items-center gap-2 text-xs text-slate-400">
                            <span id="backend-status-dot" class="w-2 h-2 rounded-full bg-amber-500 inline-block"></span>
                            <span id="backend-status-text">Checking backend API...</span>
                        </div>
                    </div>
                </div>

                <!-- User Profile & Logout -->
                <div class="flex items-center gap-4">
                    <div class="hidden sm:flex flex-col text-right">
                        <span class="text-xs text-slate-400">Logged in as</span>
                        <span id="user-email-display" class="text-sm font-medium text-slate-200">user@example.com</span>
                    </div>
                    <button onclick="handleLogout()" class="bg-slate-800 hover:bg-slate-700 active:bg-slate-900 text-slate-200 text-sm font-medium px-4 py-2 rounded-xl transition-all border border-slate-700/60 flex items-center gap-2">
                        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                        </svg>
                        <span>Logout</span>
                    </button>
                </div>
            </div>
        </header>

        <!-- Main Dashboard Workspace -->
        <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            <!-- Left Column: Input, Inbox Mail Picker, and Presets (7 Cols) -->
            <div class="lg:col-span-7 space-y-6">
                
                <!-- SELECT MESSAGE FROM INBOX SECTION -->
                <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-6 shadow-xl backdrop-blur-sm">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-sm font-semibold text-slate-200 flex items-center gap-2">
                            <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                            </svg>
                            Live Mail Inbox &amp; Scanner
                        </h2>
                        <div class="flex items-center gap-2">
                            <button onclick="openConnectMailModal()" id="btn-connect-mail" class="text-xs bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 border border-indigo-500/30 px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                                </svg>
                                <span id="connect-mail-text">Connect Live Mail</span>
                            </button>
                            <button onclick="refreshInbox()" title="Fetch latest emails" class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 p-1.5 rounded-lg transition-all">
                                <svg id="refresh-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                            </button>
                        </div>
                    </div>

                    <!-- Filter Tabs -->
                    <div class="flex items-center justify-between text-xs text-slate-400 mb-3 border-b border-slate-800/80 pb-2">
                        <div class="flex items-center gap-3">
                            <button onclick="filterMailCategory('all')" id="tab-mail-all" class="font-semibold text-indigo-400 border-b-2 border-indigo-500 pb-1">All Messages (<span id="count-all">3</span>)</button>
                            <button onclick="filterMailCategory('unscanned')" id="tab-mail-unscanned" class="hover:text-slate-200 pb-1">Unscanned (<span id="count-unscanned">3</span>)</button>
                            <button onclick="filterMailCategory('flagged')" id="tab-mail-flagged" class="hover:text-slate-200 pb-1">Flagged (<span id="count-flagged">0</span>)</button>
                        </div>
                        <span class="text-[11px] text-slate-500" id="inbox-account-status">Showing Demo Inbox</span>
                    </div>

                    <!-- Email List Preview Items -->
                    <div id="inbox-list-container" class="space-y-2.5 max-h-64 overflow-y-auto pr-1">
                        <!-- Dynamic email items rendered here -->
                    </div>
                </div>

                <!-- Message Input Card -->
                <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-6 shadow-xl backdrop-blur-sm">
                    <div class="flex items-center justify-between mb-3">
                        <label for="message-input" class="text-sm font-semibold text-slate-200 flex items-center gap-2">
                            <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                            </svg>
                            Message Content Workspace
                        </label>
                        <span id="char-counter" class="text-xs text-slate-500 font-mono">0 chars | 0 words</span>
                    </div>

                    <textarea id="message-input" rows="5" oninput="updateCounters()" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-4 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all placeholder:text-slate-600 resize-none font-mono" placeholder="Select an email above or paste raw SMS/Email text here to evaluate..."></textarea>

                    <!-- Quick Preset Buttons -->
                    <div class="mt-4">
                        <span class="text-xs font-medium text-slate-400 uppercase tracking-wider block mb-2">Quick Test Presets:</span>
                        <div class="flex flex-wrap gap-2">
                            <button onclick="loadPreset('Claim free $1000 prize card now! Click http://bit.ly/claim-win immediately.')" class="text-xs bg-slate-950 hover:bg-slate-800 border border-slate-800 text-slate-300 px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5">
                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                Spam Example ($1000 Gift)
                            </button>
                            <button onclick="loadPreset('Meeting rescheduled to 3 PM tomorrow in Conference Room B. Please confirm your attendance.')" class="text-xs bg-slate-950 hover:bg-slate-800 border border-slate-800 text-slate-300 px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                Safe Example (Meeting)
                            </button>
                        </div>
                    </div>

                    <!-- Action Button -->
                    <div class="mt-6 flex items-center justify-end gap-3">
                        <button onclick="clearInput()" class="px-4 py-2.5 text-sm font-medium text-slate-400 hover:text-slate-200 transition-all">
                            Clear
                        </button>
                        <button id="analyze-btn" onclick="analyzeMessage()" class="bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white font-medium px-6 py-2.5 rounded-xl transition-all shadow-lg shadow-indigo-600/20 flex items-center gap-2">
