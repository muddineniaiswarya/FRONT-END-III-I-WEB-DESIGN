    <!-- ========================================================== -->
    <!-- JAVASCRIPT LOGIC & STATE MANAGEMENT                        -->
    <!-- ========================================================== -->
    <script>
        const API_BASE = "http://localhost:8000";
        let sessionHistory = [];
        let connectedAccount = null;
        let activeCategoryFilter = 'all';

        // Sample Mail Inbox Items
        let sampleInbox = [
            {
                id: "msg-1",
                subject: "URGENT: Your account access has been restricted!",
                sender: "security@verify-acc-now.net",
                body: "Dear user, we detected unusual login activity. Please update your password immediately at http://verify-secure-login.com to avoid account termination.",
                status: "unscanned",
                lastVerdict: null,
                confidence: null
            },
            {
                id: "msg-2",
                subject: "Quarterly Planning Sync - Agenda Update",
                sender: "s.jenkins@company.com",
                body: "Hi team, please find attached the updated slides for tomorrow's 10 AM strategy meeting in Conference Room B. Let me know if you have any questions.",
                status: "unscanned",
                lastVerdict: null,
                confidence: null
            },
            {
                id: "msg-3",
                subject: "Congratulations! You won a $1000 Amazon Gift Card",
                sender: "promos@gift-claims.org",
                body: "You were selected as today's winner! Click http://bit.ly/claim-card to collect your $1000 voucher now before it expires in 2 hours.",
                status: "unscanned",
                lastVerdict: null,
                confidence: null
            }
        ];

        // App Initialization on load
        window.addEventListener('DOMContentLoaded', () => {
            checkAuthSession();
            checkBackendHealth();
            renderInboxList();
        });

        // --- AUTHENTICATION & VIEW MANAGEMENT ---
        function switchAuthTab(tab) {
            const signInForm = document.getElementById('form-signin');
            const signUpForm = document.getElementById('form-signup');
            const signInTab = document.getElementById('tab-signin');
            const signUpTab = document.getElementById('tab-signup');

            if (tab === 'signin') {
                signInForm.classList.remove('hidden');
                signUpForm.classList.add('hidden');
                signInTab.className = "flex-1 py-2 text-sm font-medium rounded-lg transition-all bg-indigo-600 text-white shadow-sm";
                signUpTab.className = "flex-1 py-2 text-sm font-medium rounded-lg transition-all text-slate-400 hover:text-white";
            } else {
                signInForm.classList.add('hidden');
                signUpForm.classList.remove('hidden');
                signUpTab.className = "flex-1 py-2 text-sm font-medium rounded-lg transition-all bg-indigo-600 text-white shadow-sm";
                signInTab.className = "flex-1 py-2 text-sm font-medium rounded-lg transition-all text-slate-400 hover:text-white";
            }
        }

        function checkAuthSession() {
            const token = localStorage.getItem('spam_shield_token');
            const email = localStorage.getItem('spam_shield_email');

            const authView = document.getElementById('auth-view');
            const dashboardView = document.getElementById('dashboard-view');

            if (token && email) {
                authView.classList.add('hidden');
                dashboardView.classList.remove('hidden');
                document.getElementById('user-email-display').innerText = email;
            } else {
                authView.classList.remove('hidden');
                dashboardView.classList.add('hidden');
            }
        }

        async function handleSignIn(e) {
            e.preventDefault();
            const email = document.getElementById('signin-email').value.trim();
            const password = document.getElementById('signin-password').value;

            try {
                const res = await fetch(`${API_BASE}/auth/login`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, password })
                });

                if (res.ok) {
                    const data = await res.json();
                    localStorage.setItem('spam_shield_token', data.access_token);
                    localStorage.setItem('spam_shield_email', data.user_email);
                    showToast("Signed in successfully!", "success");
                    checkAuthSession();
                    return;
                } else {
                    const err = await res.json();
                    throw new Error(err.detail || "Invalid credentials");
                }
            } catch (error) {
                console.warn("Backend unavailable or login failed. Falling back to mock client session:", error.message);
                localStorage.setItem('spam_shield_token', 'mock_jwt_token_' + Date.now());
                localStorage.setItem('spam_shield_email', email);
                showToast("Signed in successfully (Demo Mode)", "success");
                checkAuthSession();
            }
        }

        async function handleSignUp(e) {
            e.preventDefault();
            const full_name = document.getElementById('signup-name').value.trim();
            const email = document.getElementById('signup-email').value.trim();
            const password = document.getElementById('signup-password').value;
            const confirm = document.getElementById('signup-confirm').value;

            if (password !== confirm) {
                showToast("Passwords do not match!", "error");
                return;
            }

            try {
                const res = await fetch(`${API_BASE}/auth/signup`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ full_name, email, password })
                });

                if (res.ok) {
                    showToast("Account created successfully! Please sign in.", "success");
                    switchAuthTab('signin');
                    document.getElementById('signin-email').value = email;
                } else {
                    const err = await res.json();
                    throw new Error(err.detail || "Registration failed");
                }
            } catch (error) {
                console.warn("Backend unavailable. Mock registration success:", error.message);
                showToast("Account registered successfully (Demo Mode)", "success");
                switchAuthTab('signin');
                document.getElementById('signin-email').value = email;
            }
        }

        function handleLogout() {
            localStorage.removeItem('spam_shield_token');
            localStorage.removeItem('spam_shield_email');
            showToast("Logged out securely.", "info");
            checkAuthSession();
        }

        // --- FORGOT PASSWORD MODAL HANDLERS ---
        function openForgotPasswordModal() {
            document.getElementById('forgot-password-modal').classList.remove('hidden');
        }

        function closeForgotPasswordModal() {
            document.getElementById('forgot-password-modal').classList.add('hidden');
        }

        function handleSendResetLink(e) {
            e.preventDefault();
            const email = document.getElementById('reset-email-input').value.trim();
            if (email) {
                showToast(`Password reset link sent to ${email}`, "success");
                closeForgotPasswordModal();
            }
        }

        // --- MAIL INBOX RENDERING & FILTERING ---
        function renderInboxList() {
            const container = document.getElementById('inbox-list-container');
            
            // Calculate category counts
            const total = sampleInbox.length;
            const unscanned = sampleInbox.filter(m => m.status === 'unscanned').length;
            const flagged = sampleInbox.filter(m => m.lastVerdict === 'SPAM').length;

            document.getElementById('count-all').innerText = total;
            document.getElementById('count-unscanned').innerText = unscanned;
            document.getElementById('count-flagged').innerText = flagged;

            let filtered = sampleInbox;
            if (activeCategoryFilter === 'unscanned') {
                filtered = sampleInbox.filter(m => m.status === 'unscanned');
            } else if (activeCategoryFilter === 'flagged') {
                filtered = sampleInbox.filter(m => m.lastVerdict === 'SPAM');
            }

            if (filtered.length === 0) {
                container.innerHTML = `<div class="text-center py-8 text-slate-600 text-xs italic">No messages found in this view.</div>`;
                return;
            }

            container.innerHTML = filtered.map((mail, idx) => {
                const globalIndex = sampleInbox.findIndex(m => m.id === mail.id);
                
                let badge = `<span class="text-[10px] bg-slate-800 text-slate-400 px-1.5 py-0.5 rounded border border-slate-700">Unscanned</span>`;
                if (mail.lastVerdict === 'SPAM') {
                    badge = `<span class="text-[10px] bg-rose-500/20 text-rose-400 px-1.5 py-0.5 rounded border border-rose-500/30 font-semibold">SPAM (${mail.confidence}%)</span>`;
                } else if (mail.lastVerdict === 'HAM') {
                    badge = `<span class="text-[10px] bg-emerald-500/20 text-emerald-400 px-1.5 py-0.5 rounded border border-emerald-500/30 font-semibold">SAFE (${mail.confidence}%)</span>`;
                }

                return `
                    <div onclick="selectMailItem(${globalIndex})" class="p-3 bg-slate-950 border border-slate-800/80 hover:border-indigo-500/50 rounded-xl cursor-pointer transition-all flex items-center justify-between group">
                        <div class="min-w-0 pr-3">
                            <div class="flex items-center gap-2 mb-1 flex-wrap">
                                <span class="text-xs font-semibold text-slate-200">${escapeHTML(mail.sender)}</span>
                                ${badge}
                            </div>
                            <p class="text-xs font-medium text-slate-300 truncate">${escapeHTML(mail.subject)}</p>
                            <p class="text-[11px] text-slate-500 truncate">${escapeHTML(mail.body)}</p>
                        </div>
                        <button class="shrink-0 bg-slate-800 group-hover:bg-indigo-600 text-slate-300 group-hover:text-white text-xs px-3 py-1.5 rounded-lg transition-all flex items-center gap-1">
                            <span>Scan Mail</span>
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                        </button>
                    </div>
                `;
            }).join('');
        }

        function filterMailCategory(category) {
            activeCategoryFilter = category;
            const tabs = ['all', 'unscanned', 'flagged'];
            tabs.forEach(t => {
                const el = document.getElementById(`tab-mail-${t}`);
                if (t === category) {
                    el.className = "font-semibold text-indigo-400 border-b-2 border-indigo-500 pb-1";
                } else {
                    el.className = "hover:text-slate-200 pb-1";
                }
            });
            renderInboxList();
        }

        function refreshInbox() {
            const icon = document.getElementById('refresh-icon');
            icon.classList.add('animate-spin');
            setTimeout(() => {
                icon.classList.remove('animate-spin');
                showToast("Inbox synced with email provider.", "info");
                renderInboxList();
            }, 600);
        }

        // --- MAIL CONNECT MODAL ---
        function openConnectMailModal() {
            document.getElementById('connect-mail-modal').classList.remove('hidden');
        }

        function closeConnectMailModal() {
            document.getElementById('connect-mail-modal').classList.add('hidden');
        }

        function handleConnectAccount(e) {
            e.preventDefault();
            const provider = document.getElementById('mail-provider').value;
            const email = document.getElementById('connect-email-input').value.trim();
            const rawMail = document.getElementById('import-raw-mail').value.trim();

            if (rawMail) {
                // Import custom pasted raw email
                const newMail = {
                    id: "msg-" + Date.now(),
                    subject: "Custom Imported Message",
                    sender: email || "external@imported.com",
                    body: rawMail,
                    status: "unscanned",
                    lastVerdict: null,
                    confidence: null
                };
                sampleInbox.unshift(newMail);
                showToast("Custom email imported to inbox list!", "success");
            } else if (email) {
                connectedAccount = { provider, email };
                document.getElementById('inbox-account-status').innerText = `Connected: ${email}`;
                document.getElementById('connect-mail-text').innerText = "Connected";
                showToast(`Connected to ${email} successfully!`, "success");
            }

            closeConnectMailModal();
            renderInboxList();
        }

        // --- MAIL SELECTION & SCAN HANDLER ---
        function selectMailItem(index) {
            const mail = sampleInbox[index];
            if (mail) {
                const combinedText = `From: ${mail.sender}\nSubject: ${mail.subject}\n\n${mail.body}`;
                document.getElementById('message-input').value = combinedText;
                updateCounters();
                
                // Trigger AI prediction scan and store back result in inbox item
                analyzeMessage().then((result) => {
                    if (result) {
                        mail.status = "scanned";
                        mail.lastVerdict = result.prediction;
                        mail.confidence = result.confidence;
                        renderInboxList();
                    }
                });

                openMailDrawer(mail);
                showToast("Message loaded and scanned!", "info");
            }
        }

        // --- MAIL DRAWER HANDLERS ---
        function openMailDrawer(mail) {
            document.getElementById('drawer-sender').innerText = mail.sender;
            document.getElementById('drawer-subject').innerText = mail.subject;
            document.getElementById('drawer-body').innerText = mail.body;
            document.getElementById('mail-drawer').classList.remove('hidden');
        }

        function closeMailDrawer() {
            document.getElementById('mail-drawer').classList.add('hidden');
        }

        // --- BACKEND HEALTH CHECK ---
        async function checkBackendHealth() {
            const dot = document.getElementById('backend-status-dot');
            const text = document.getElementById('backend-status-text');
            try {
                const res = await fetch(`${API_BASE}/`);
                if (res.ok) {
                    dot.className = "w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse";
                    text.innerText = "Connected to FastAPI Server";
                } else {
                    throw new Error();
                }
            } catch {
                dot.className = "w-2 h-2 rounded-full bg-amber-500 inline-block";
                text.innerText = "Running in Client Demo Mode";
            }
        }

        // --- DASHBOARD CORE FUNCTIONS ---
        function updateCounters() {
            const text = document.getElementById('message-input').value;
            const chars = text.length;
            const words = text.trim() === '' ? 0 : text.trim().split(/\s+/).length;
            document.getElementById('char-counter').innerText = `${chars} chars | ${words} words`;
        }

        function loadPreset(presetText) {
            document.getElementById('message-input').value = presetText;
            updateCounters();
        }

        function clearInput() {
            document.getElementById('message-input').value = '';
            updateCounters();
        }

        async function analyzeMessage() {
            const text = document.getElementById('message-input').value.trim();
            const user_email = localStorage.getItem('spam_shield_email') || 'anonymous@shield.io';

            if (!text) {
                showToast("Please enter or select a message to analyze.", "error");
                return null;
            }

            setLoading(true);

            let resultData;
            try {
                const res = await fetch(`${API_BASE}/predict`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: text, user_email })
                });

                if (!res.ok) throw new Error("API call failed");
                resultData = await res.json();
            } catch (error) {
                console.warn("Using client-side heuristic prediction fallback:", error);
                resultData = mockPredict(text, user_email);
            }

            setLoading(false);
            displayResult(resultData);
            logSession(resultData);
            return resultData;
        }

        function setLoading(isLoading) {
            const btn = document.getElementById('analyze-btn');
            const textSpan = document.getElementById('analyze-btn-text');
            if (isLoading) {
                btn.disabled = true;
                btn.className = "bg-indigo-600/50 text-white font-medium px-6 py-2.5 rounded-xl transition-all flex items-center gap-2 cursor-not-allowed";
                textSpan.innerHTML = `<svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline-block" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Analyzing...`;
            } else {
                btn.disabled = false;
                btn.className = "bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white font-medium px-6 py-2.5 rounded-xl transition-all shadow-lg shadow-indigo-600/20 flex items-center gap-2";
                textSpan.innerText = "Analyze Message";
            }
        }

        function mockPredict(text, user_email) {
            const spamKeywords = ['win', 'free', 'prize', 'claim', 'urgent', 'http://', 'bit.ly', '$', 'cash', 'credit', 'verify', 'restricted', 'termination'];
            const lower = text.toLowerCase();
            let matches = spamKeywords.filter(kw => lower.includes(kw)).length;
            
            const isSpam = matches >= 2 || lower.includes('claim') || lower.includes('urgent') || lower.includes('verify');
            const confidence = isSpam ? Math.min(92.5 + (matches * 2), 99.4) : Math.min(95.0 + (Math.random() * 4), 99.9);
            
            let risk_level = "Low";
            if (isSpam) {
                risk_level = confidence > 90 ? "High" : "Medium";
            } else if (confidence < 80) {
                risk_level = "Medium";
            }

            return {
                prediction: isSpam ? "SPAM" : "HAM",
                confidence: parseFloat(confidence.toFixed(1)),
                risk_level: risk_level,
                user_email: user_email,
                message: text
            };
        }

        function displayResult(data) {
            document.getElementById('result-placeholder').classList.add('hidden');
            document.getElementById('result-active').classList.remove('hidden');

            const banner = document.getElementById('verdict-banner');
            const iconContainer = document.getElementById('verdict-icon-container');
            const title = document.getElementById('verdict-title');

            if (data.prediction === 'SPAM') {
                banner.className = "p-4 rounded-xl border bg-rose-950/30 border-rose-900/50 flex items-center gap-3";
                iconContainer.className = "w-10 h-10 rounded-lg bg-rose-500/20 border border-rose-500/30 text-rose-400 flex items-center justify-center shrink-0";
                iconContainer.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>`;
                title.className = "text-lg font-bold tracking-tight text-rose-400";
                title.innerText = "SPAM DETECTED";
            } else {
                banner.className = "p-4 rounded-xl border bg-emerald-950/30 border-emerald-900/50 flex items-center gap-3";
                iconContainer.className = "w-10 h-10 rounded-lg bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 flex items-center justify-center shrink-0";
                iconContainer.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>`;
                title.className = "text-lg font-bold tracking-tight text-emerald-400";
                title.innerText = "SAFE / HAM";
            }

            document.getElementById('confidence-val').innerText = `${data.confidence}%`;
            const bar = document.getElementById('confidence-bar');
            bar.style.width = `${data.confidence}%`;
            bar.className = data.prediction === 'SPAM' ? "bg-rose-500 h-2.5 rounded-full transition-all duration-500" : "bg-emerald-500 h-2.5 rounded-full transition-all duration-500";

            document.getElementById('risk-val').innerText = data.risk_level;
            document.getElementById('word-val').innerText = data.message.trim().split(/\s+/).length;
            document.getElementById('scan-timestamp').innerText = new Date().toLocaleTimeString();
        }

        function logSession(data) {
            sessionHistory.unshift({ ...data, timestamp: new Date().toLocaleTimeString() });
            renderHistory();
        }

        function renderHistory() {
            const container = document.getElementById('history-container');
            if (sessionHistory.length === 0) {
                container.innerHTML = `<div class="text-center py-8 text-slate-600 text-xs italic">No scans performed in this session yet.</div>`;
                return;
            }

            container.innerHTML = sessionHistory.map((item, idx) => `
                <div onclick="loadHistoryItem(${idx})" class="bg-slate-950/50 border border-slate-800/60 hover:border-slate-700 p-3 rounded-xl cursor-pointer transition-all flex items-center justify-between gap-3 group">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2 mb-1">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold ${item.prediction === 'SPAM' ? 'bg-rose-500/20 text-rose-400 border border-rose-500/30' : 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30'}">${item.prediction}</span>
                            <span class="text-xs text-slate-400 font-mono">${item.confidence}% confidence</span>
                        </div>
                        <p class="text-xs text-slate-300 truncate">${escapeHTML(item.message)}</p>
                    </div>
                    <span class="text-[10px] text-slate-600 font-mono shrink-0">${item.timestamp}</span>
                </div>
            `).join('');
        }

        function loadHistoryItem(index) {
            const item = sessionHistory[index];
            if (item) {
                document.getElementById('message-input').value = item.message;
                updateCounters();
                displayResult(item);
            }
        }

        function clearHistory() {
            sessionHistory = [];
            renderHistory();
        }

        function escapeHTML(str) {
            return str.replace(/[&<>'"]/g, 
                tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
            );
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const borderColor = type === 'success' ? 'border-emerald-500/30 bg-emerald-950/90 text-emerald-200' : (type === 'error' ? 'border-rose-500/30 bg-rose-950/90 text-rose-200' : 'border-indigo-500/30 bg-indigo-950/90 text-indigo-200');
            
            toast.className = `pointer-events-auto px-4 py-3 rounded-xl border ${borderColor} shadow-2xl backdrop-blur-md text-xs font-medium transition-all duration-300 translate-y-2 opacity-0 flex items-center gap-2`;
            toast.innerHTML = `<span>${message}</span>`;
            
            container.appendChild(toast);
            setTimeout(() => toast.classList.remove('translate-y-2', 'opacity-0'), 10);
            setTimeout(() => {
                toast.classList.add('translate-y-2', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }
    </script>
</body>
</html>
